# Copy to .env and fill in. Services refuse to start with empty, short (<32 chars),
# default or identical secrets. Use hex so values stay URL-safe in MONGO_URL.

# generate: openssl rand -hex 32
JWT_SECRET=
# generate: openssl rand -hex 32 (must differ from JWT_SECRET)
INTERNAL_SERVICE_SECRET=

MONGO_ROOT_USER=novabank
# generate: openssl rand -hex 32
MONGO_ROOT_PASSWORD=

# Optional SMTP. Leave SMTP_HOST empty to print OTP codes in `docker compose logs auth`.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Empty uses the compose default: NovaBank <no-reply@example.com>
MAIL_FROM=
